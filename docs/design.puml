
@startuml system
title Typst Blog System - Architecture

left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "執筆者" as User
component "テキストエディタ\nZed / VS Code / etc." as Editor

package "typst-src/ (Input)" as Source {
  folder "commons/" as Commons {
    folder "components/" as Components
    folder "ogp/" as OgpTemplate
  }
  folder "templates/" as Templates

  folder "articles/<foldername>/" as ArticleSource {
    file "main.typ" as MainTyp
    file "ArticleConfig.toml" as ArticleConfig
    folder "assets/" as SourceAssets
  }
}

component "Content Compiler" as Compiler

package "generated/ (Build outputs)" as Generated {
  file "site.json" as SiteJson
  file "article-index.json" as ArticleIndex

  folder "articles/<slug>/" as ArticleOutput {
    file "body.html" as BodyHtml
    file "meta.json" as MetaJson
  }

  folder "public-root/ogp/articles/" as PublicOgp {
    file "<slug>.png" as OgpImage
  }

  folder ".cache/" as CacheDirectory {
    file "manifest.json" as CacheManifest
  }
}

package "Frontend" as Frontend {
  component "Static Site Generator\n(e.g. Astro)" as SSG
  component "UI / Layout / CSS" as UI
}

folder "dist/" as Dist
cloud "Static Hosting" as Hosting

User --> Editor : 執筆
Editor --> Source : ファイル編集

Source --> Compiler : ソース入力
Compiler --> Generated : 成果物出力

Generated --> SSG : 読み込み
UI --> SSG : 表示構築
SSG --> Dist : 静的サイト生成
Dist --> Hosting : デプロイ

note bottom of SSG
  typst-src/ への依存は禁止。
  generated/ のみを
  コンテンツ入力として使用する。
end note

note bottom of ArticleConfig
  slug と foldername は独立。
  URL: /articles/<slug>/
end note


@enduml


@startuml compiler-architecture
title Content Compiler - Internal Architecture

top to bottom direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

folder "typst-src/" as Source

package "Content Compiler" {

  component "SourceLoader\n入力を発見" as SourceLoader
  component "SourceParser\nArticle・Siteを検証" as SourceParser
  component "BlogCacheLoader\n現在指紋・既存成果物・前回指紋" as CacheLoader
  component "BuildCache\nHTML・OGP変更判定" as BuildCache
  component "BuildCacheWriter\nManifest更新" as BuildCacheWriter

  package "HTML Pipeline" {
    component "ArticleTransformer\nHTML変換・後処理" as ArticleTransformer
    component "ArticleWriter\nbody.html書き込み" as ArticleWriter
  }

  package "OGP Pipeline" {
    component "OgpGenerator\nOGP画像生成" as OgpGenerator
    component "OgpWriter\n<slug>.png書き込み" as OgpWriter
  }

  component "MetadataWriter\nJSON生成・書き込み" as MetadataWriter

  SourceLoader --> SourceParser
  SourceParser --> CacheLoader : ParsedSource
  CacheLoader --> BuildCache : BlogCacheInput
  CacheLoader --> BuildCacheWriter : BlogCacheInput

  SourceParser --> ArticleTransformer : HTML再生成対象
  BuildCache --> ArticleTransformer : HTML cache判定 / filter
  ArticleTransformer --> ArticleWriter : HTML
  ArticleWriter --> Generated : body.html
  ArticleWriter --> BuildCacheWriter : HTML書き込み成功

  SourceParser --> OgpGenerator : OGP再生成対象
  BuildCache --> OgpGenerator : OGP cache判定 / filter
  OgpGenerator --> OgpWriter : PNG
  OgpWriter --> Generated : <slug>.png
  OgpWriter --> BuildCacheWriter : OGP書き込み成功

  SourceParser --> MetadataWriter : ParsedSource
  MetadataWriter --> Generated : site.json / article-index.json / meta.json
  BuildCacheWriter --> CacheManifest : 原子的に更新
}

folder "generated/" as Generated {
  folder ".cache/" as CacheDirectory {
    file "manifest.json" as CacheManifest
  }
}

Source --> SourceLoader

note right of ArticleTransformer
  Typst HTML出力を変換・後処理する
end note

note right of OgpGenerator
  記事とSiteのメタデータからPNGを生成する
end note

@enduml


@startuml compile-pipeline
title Article HTML Compilation Pipeline

start

:main.typ を取得;

partition "Typst Compilation" {
  :TypstコンパイラでHTMLへ変換;
  :生成したHTMLを取得;
}

partition "HTML Post Processing" {
  :HTMLから記事本文を抽出;
  :未対応機能を補完・変換;
  :アセットの参照先を解決;
  :HTML断片の整合性を検証;
}

partition "Article Write" {
  :body.html を出力;
}

stop
@enduml


@startuml postprocessor
title HTML Postprocessor - Pipeline Architecture

top to bottom direction
skinparam componentStyle rectangle

component "Typst CLI" as Typst

package "HTML Postprocessor" {
  component "HTML Parser" as Parser

  package "Processing Pipeline" {
    component "Processor 1\nCode Block" as P1
    component "Processor 2\nLink Card" as P2
    component "Processor 3\n..." as P3
  }

  component "HTML Serializer" as Serializer
  component "HTML Validator" as Validator
}

artifact "body.html" as Output

Typst --> Parser : HTML
Parser --> P1 : HTML Document
P1 --> P2 : Document
P2 --> P3 : Document
P3 --> Serializer : Document
Serializer --> Validator : HTML
Validator --> Output

note right of P3
  新しいProcessorを
  パイプラインへ追加可能
end note

@enduml
