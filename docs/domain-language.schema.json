{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Blog domain language",
  "description": "docs/domain-language.toml の構造を定義する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["terms"],
  "properties": {
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "naming", "description"],
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "命名対象となるドメイン概念または範囲。"
          },
          "naming": {
            "type": "string",
            "minLength": 1,
            "description": "概念に対応させる標準的な命名。"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "概念の意味と適用範囲。"
          },
          "notes": {
            "type": "string",
            "description": "表記上の注意、例、避ける名前など。"
          }
        }
      }
    }
  }
}
