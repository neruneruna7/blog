---
import ArticleCard from "@/components/ArticleCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArticles, getSiteConfig } from "@/lib/articles";

const site = await getSiteConfig();
const articles = await getArticles();
---

<BaseLayout site={site}>
  <section class="pb-14" aria-labelledby="article-list-heading">
    <div class="mb-5 flex items-end justify-between gap-4">
      <h2 id="article-list-heading" class="m-4 font-heading text-2xl">記事</h2>
      <p class="m-0 text-sm text-muted-foreground">
        {articles.length} entries
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <ArticleCard article={article} language={site.language} />
        ))
      }
    </div>
  </section>
</BaseLayout>
