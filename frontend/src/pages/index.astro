---
import ArticleCard from "../components/ArticleCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getArticles, getSiteConfig } from "../lib/articles";

import {
    Card,
    CardContent,
    CardDescription,
    CardHeader,
    CardTitle,
} from "@/components/ui/card";
const site = await getSiteConfig();
const articles = await getArticles();
---

<SiteLayout site={site}>
    <section class="home-header">
        <h1>{site.title}</h1>
        <p>{site.description}</p>
    </section>

    <section
        class="article-list-section"
        aria-labelledby="article-list-heading"
    >
        <h2 id="article-list-heading">Articles</h2>
        <div class="article-card-grid">
            {
                articles.map((article) => (
                    <ArticleCard article={article} language={site.language} />
                ))
            }
        </div>
        <Card className="max-w-sm">
            <CardHeader>
                <CardTitle>Project Overview</CardTitle>
                <CardDescription>
                    Track progress and recent activity for your Astro app.
                </CardDescription>
            </CardHeader>
            <CardContent>
                Your design system is ready. Start building your next component.
            </CardContent>
        </Card>
    </section>
</SiteLayout>
