---
import type { ArticleMeta, SiteConfig } from "@/lib/articles";

type Props = {
  site: SiteConfig;
  article: ArticleMeta;
};

const { site, article } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat(site.language, {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});

const publishedAt = dateFormatter.format(new Date(article.publishedAt));
---

<header class="article-header relative isolate overflow-hidden">
  <!-- 右上から差し込む静的な光 -->
  <div
    class="article-header__light pointer-events-none absolute inset-0 z-0"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-2xl px-1 pt-12 pb-20 md:pt-16 md:pb-24"
  >
    <!-- 記事タイトル -->
    <h1
      class="font-heading m-0 text-center text-[clamp(2.25rem,5.5vw,4rem)] leading-[1.35] font-medium tracking-[0.06em] text-balance text-black"
    >
      {article.title}
    </h1>

    <!-- 二本の黒い横線 -->
    <div class="mt-5 space-y-3" aria-hidden="true">
      <div class="h-0.5 w-full bg-black"></div>
      <div class="h-0.5 w-full bg-black"></div>
    </div>

    <!-- 記事説明 -->
    {
      article.description && (
        <p class="font-body mx-auto mt-20 max-w-xl text-center text-base leading-8 text-black/70">
          {article.description}
        </p>
      )
    }

    <!-- タグと公開日 -->
    <div
      class="mt-14 grid grid-cols-1 gap-6 font-sans text-sm text-black/80 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end"
    >
      <div class="min-w-0">
        {
          article.tags.length > 0 && (
            <ul
              class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0"
              aria-label="タグ"
            >
              {article.tags.map((tag, index) => (
                <li class="flex items-center gap-4">
                  <span>{tag}</span>

                  {index < article.tags.length - 1 && (
                    <span class="text-black/35" aria-hidden="true" />
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <time
        class="justify-self-start tracking-[0.08em] tabular-nums sm:justify-self-end"
        datetime={article.publishedAt}
      >
        <span class="sr-only">公開日，</span>
        {publishedAt}
      </time>
    </div>
  </div>
</header>

<style>
  /*
   * なぜ実装するのか:
   * 記事ヘッダーの右上に静的な光源を置き，
   * 無彩色の背景へ奥行きを与えるためである．
   *
   * 期待する動作:
   * アニメーションせず，右上だけが背景より淡く明るく見える．
   */
  .article-header__light {
    background:
      radial-gradient(
        ellipse at 94% 0%,
        rgb(255 255 255 / 94%) 0%,
        rgb(255 255 255 / 62%) 16%,
        rgb(255 255 255 / 24%) 35%,
        transparent 62%
      ),
      linear-gradient(
        135deg,
        transparent 52%,
        rgb(255 255 255 / 14%) 71%,
        transparent 88%
      );
  }
</style>
