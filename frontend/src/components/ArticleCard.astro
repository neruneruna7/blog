---
import type { ArticleMeta } from "@/lib/articles";
import { Card } from "@/components/ui/card";

type Props = {
  article: ArticleMeta;
  language: string;
};

const { article, language } = Astro.props;
const publishedAt = new Intl.DateTimeFormat(language).format(
  new Date(article.publishedAt),
);
---

<Card
  className="h-full py-0 transition-transform duration-200 hover:-translate-y-0.5 hover:ring-foreground/20"
>
  <article class="h-full">
    <a class="grid h-full gap-4 p-5 no-underline" href={article.url}>
      <div class="grid gap-2">
        <time
          class="text-sm text-muted-foreground"
          datetime={article.publishedAt}
        >
          {publishedAt}
        </time>

        <h2 class="m-0 font-heading text-xl leading-snug tracking-tight">
          {article.title}
        </h2>

        <p class="m-0 text-sm leading-6 text-muted-foreground">
          {article.description}
        </p>
      </div>

      <ul class="flex flex-wrap gap-2 p-0 m-0 list-none" aria-label="Tags">
        {
          article.tags.map((tag) => (
            <li class="inline-flex h-5 w-fit shrink-0 items-center justify-center border border-border bg-muted px-2.5 py-0.5 text-xs whitespace-nowrap text-muted-foreground transform-[skewX(-24deg)]">
              <span class="inline-block transform-[skewX(18deg)]">{tag}</span>
            </li>
          ))
        }
      </ul>
    </a>
  </article>
</Card>
