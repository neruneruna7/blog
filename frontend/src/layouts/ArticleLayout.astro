---
import SiteLayout from "./SiteLayout.astro";
import type { ArticleMeta, SiteConfig } from "../lib/articles";

type Props = {
  site: SiteConfig;
  article: ArticleMeta;
};

const { site, article } = Astro.props;
---

<SiteLayout site={site} title={`${article.title} | ${site.title}`} description={article.description}>
  <article class="article-page">
    <header class="article-header">
      <p class="article-kicker">Article</p>
      <h1>{article.title}</h1>
      <p class="article-description">{article.description}</p>
      <dl class="article-dates">
        <div>
          <dt>Published</dt>
          <dd>
            <time datetime={article.publishedAt}>
              {new Intl.DateTimeFormat(site.language).format(new Date(article.publishedAt))}
            </time>
          </dd>
        </div>
        {
          article.updatedAt && (
            <div>
              <dt>Updated</dt>
              <dd>
                <time datetime={article.updatedAt}>
                  {new Intl.DateTimeFormat(site.language).format(new Date(article.updatedAt))}
                </time>
              </dd>
            </div>
          )
        }
      </dl>
      <ul class="tag-list" aria-label="Tags">
        {article.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>
</SiteLayout>
