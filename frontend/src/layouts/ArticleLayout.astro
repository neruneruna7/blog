---
import ArticleHeader from "@/components/site/ArticleHeader.astro";
import ArticleOgpMeta from "@/components/site/ArticleOgpMeta.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ArticleMeta, SiteConfig } from "@/lib/articles";

import "@/styles/typst-article-body.css";

type Props = {
  site: SiteConfig;
  article: ArticleMeta;
};

const { site, article } = Astro.props;
---

<BaseLayout
  site={site}
  title={`${article.title} | ${site.title}`}
  description={article.description}
>
  <ArticleOgpMeta slot="head" site={site} article={article} />

  <article>
    <ArticleHeader site={site} article={article} />

    <div class="mx-auto max-w-4xl pb-20 md:pb-28">
      <slot />
    </div>
  </article>
</BaseLayout>
