---
import "@/styles/global.css";
import "@/styles/sample.css";
import { SiteHeader } from "@/components/site/SiteHeader";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import type { SiteConfig } from "@/lib/articles";

type Props = {
  site: SiteConfig;
  title?: string;
  description?: string;
};

const {
  site,
  title = site.title,
  description = site.description,
} = Astro.props;
const ga4TrackingCode = `
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-2S0WVQ9KYB"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-2S0WVQ9KYB');
</script>
`;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Fragment set:html={ga4TrackingCode} />
    <!--  子要素の持つ `slot="head"`で指定された要素の内容を挿入する-->
    <slot name="head" />
  </head>

  <body class="min-h-svh bg-background text-foreground antialiased">
    <SiteHeader site={site} currentPath={Astro.url.pathname} />
    <main class="mx-auto w-[min(100%-2rem,64rem)]">
      <slot />
      <!-- <div class="gem-surface gem-surface--phos">フォスフォフィライト</div>

      <div class="gem-surface gem-surface--cinnabar">辰砂</div> -->
    </main>
  </body>
</html>
